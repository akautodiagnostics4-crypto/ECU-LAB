# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# STRIPE_PUBLISHABLE_KEY: Required for Stripe PaymentSheet Checkout (e.g., pk_live_... or pk_test_...).
# Configure your Stripe Publishable Key in the Secrets panel in AI Studio.
STRIPE_PUBLISHABLE_KEY=STRIPE_PUBLISHABLE_KEY_DEFAULT_VALUE

# RAZORPAY_KEY_ID: Required for Razorpay Checkout (e.g., rzp_live_... or rzp_test_...).
# Configure your Razorpay Key ID in the Secrets panel in AI Studio.
RAZORPAY_KEY_ID=RAZORPAY_KEY_ID_DEFAULT_VALUE
